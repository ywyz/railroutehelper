<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>RailRouteAssistant</AssemblyName>
    <RootNamespace>RailRouteAssistant</RootNamespace>
    <Version>2.5.1</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- CI 构建时由 workflow 提供 GameDir 指向下载的 BepInEx 目录 -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Rail Route</GameDir>
    <ManagedDir>$(GameDir)\Rail Route_Data\Managed</ManagedDir>
    <BepInExCoreDir>$(GameDir)\BepInEx\core</BepInExCoreDir>
    <PluginOutputDir>$(GameDir)\BepInEx\plugins</PluginOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- UnityEngine 和 RailRoute 仅本地开发时引用，CI 中通过反射访问 -->
  <ItemGroup Condition="Exists('$(ManagedDir)\UnityEngine.dll')">
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RailRoute">
      <HintPath>$(ManagedDir)\RailRoute.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- GitHub Actions 没有也不应分发游戏 DLL。仅在游戏 Managed 目录不可用时，
       用最小类型桩满足 BaseUnityPlugin 的编译期继承链；桩不会进入发布包。 -->
  <ItemGroup Condition="!Exists('$(ManagedDir)\UnityEngine.dll')">
    <ProjectReference Include="..\build\UnityEngine.CoreModule.Stub\UnityEngine.CoreModule.Stub.csproj"
                      Private="false" />
  </ItemGroup>

  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(PluginOutputDir)')">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="$(PluginOutputDir)" />
    <Message Importance="high" Text="已复制到 BepInEx plugins: $(PluginOutputDir)" />
  </Target>

</Project>
