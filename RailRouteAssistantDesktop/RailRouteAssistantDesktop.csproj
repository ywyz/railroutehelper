<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RailRouteAssistantDesktop</AssemblyName>
    <RootNamespace>RailRouteAssistantDesktop</RootNamespace>
    <Version>2.6.6</Version>
    <Nullable>disable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 发布为单文件时也必须把两级离线车次表带入程序，换电脑后才能继续降级查询。 -->
    <IncludeAllContentForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\RailRouteHelper.Core\RailRouteHelper.Core.csproj" />
  </ItemGroup>

  <!-- 正式单文件发布把 BepInEx 与插件压缩包嵌入 EXE。开发构建不传此属性，
       因而仍可直接启动桌面 UI，不触发安装流程。 -->
  <ItemGroup Condition="'$(InstallerPayloadZip)' != '' and Exists('$(InstallerPayloadZip)')">
    <EmbeddedResource Include="$(InstallerPayloadZip)"
                      LogicalName="RailRouteAssistantDesktop.InstallerPayload.zip" />
  </ItemGroup>

  <Target Name="ValidateInstallerPayload"
          BeforeTargets="PrepareForBuild"
          Condition="'$(InstallerPayloadZip)' != '' and !Exists('$(InstallerPayloadZip)')">
    <Error Text="InstallerPayloadZip does not exist: $(InstallerPayloadZip)" />
  </Target>

  <ItemGroup>
    <None Include="assets\audio\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\audio\%(RecursiveDir)%(FileName)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="data\train_routes_offline.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="data\train_list_12306_legacy.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
